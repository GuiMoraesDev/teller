{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"baseUrl": "./src",
		"jsx": "react-jsx",
		"paths": {
			"@types": ["./src/@types"],
			"components/*": ["./src/components/*"],
			"constant": ["./src/constant"],
			"constant/*": ["./src/constant/*"],
			"helpers/*": ["./src/helpers/*"],
			"layouts/*": ["./src/layouts/*"],
			"patterns/*": ["./src/patterns/*"],
			"services/*": ["./src/services/*"],
			"views/*": ["./src/views/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.astro", "src/env.d.ts"],
	"exclude": ["node_modules"]
}
