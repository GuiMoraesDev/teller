{
	"name": "teller",
	"version": "0.1.0",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint -- --fix",
		"test": "turbo run test",
		"prepare": "husky install"
	},
	"packageManager": "npm@10.9.2",
	"devDependencies": {
		"@commitlint/cli": "^17.0.3",
		"@commitlint/config-conventional": "^17.0.3",
		"git-branch-is": "^4.0.0",
		"husky": "^7.0.0",
		"turbo": "^2.0.0"
	}
}
